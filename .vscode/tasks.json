{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Debug",
			"type": "shell",
			"command": "BUILD_TYPE=Debug ./build.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false,
			"detail": "Build Debug via BUILD_TYPE=Debug ./build.sh (Qt 6.11, output: build/cudasdr)"
		},
		{
			"label": "Build Release",
			"type": "shell",
			"command": "BUILD_TYPE=Release ./build.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false,
			"detail": "Build Release via BUILD_TYPE=Release ./build.sh (Qt 6.11, output: build/cudasdr)"
		},
		{
			"label": "Configure CMake (Debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"debug"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false,
			"detail": "Configure CMake with the debug preset (./build, CMAKE_BUILD_TYPE=Debug)"
		},
		{
			"label": "Configure CMake (Release)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"default"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false,
			"detail": "Configure CMake with the default preset (./build, CMAKE_BUILD_TYPE=Release)"
		},
		{
			"label": "Clean Build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--target",
				"clean"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false,
			"detail": "Clean the build directory"
		},
		{
			"label": "Run cudasdr",
			"type": "shell",
			"command": "./run_cudasdr.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"isBackground": false,
			"dependsOn": "Build Debug",
			"detail": "Run cudasdr via run_cudasdr.sh (Qt 6.11 env)",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			}
		},
		{
			"label": "Full Rebuild Debug",
			"type": "shell",
			"command": "rm -rf build && BUILD_TYPE=Debug ./build.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false,
			"detail": "Clean build/ and rebuild Debug from scratch"
		},
		{
			"label": "Check Dependencies",
			"type": "shell",
			"command": "ldd",
			"args": [
				"build/cudasdr"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"isBackground": false,
			"dependsOn": "Build Debug",
			"detail": "Check shared library dependencies"
		}
	]
}
